<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h2 class="text-center">Kinderpedia Document Downloader</h2>
        </div>
        <div class="card-body">
          <% if flash[:notice] %>
            <div class="alert alert-success">
              <%= flash[:notice] %>
            </div>
          <% end %>

          <% if flash[:alert] %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_tag download_kinderpedia_path, method: :post, class: "mt-3" do %>
            <div class="mb-3">
              <%= label_tag :child_url, "Child's URL", class: "form-label" %>
              <%= text_field_tag :child_url, nil, class: "form-control", placeholder: "https://app.kinderpedia.co/mykp/children/view-child/child_id/general", required: true %>
            </div>
            <br>
            <%= submit_tag "Download Documents for this child", class: "btn btn-primary w-100" %>
          <% end %>
          <br>
          <%= form_tag download_all_kinderpedia_path, method: :post do %>
            <%= submit_tag "Download Documents for All Children", class: "btn btn-success w-100" %>
          <% end %>

          <% if @children_data&.any? %>
            <div class="mt-4">
              <h4>Children List</h4>
              <div class="table-responsive">
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th>Child ID</th>
                      <th>Family ID</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @children_data.each do |child| %>
                      <tr>
                        <td><%= child[:child_id] %></td>
                        <td><%= child[:family_id] %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
