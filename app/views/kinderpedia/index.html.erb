<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h2 class="text-center">Kinderpedia Document Downloader</h2>
        </div>
        <div class="card-body">
          <% if flash[:notice] %>
            <div class="alert alert-success">
              <%= flash[:notice] %>
            </div>
          <% end %>

          <% if flash[:alert] %>
            <div class="alert alert-danger">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <%= form_tag download_kinderpedia_path, method: :post, class: "mt-3" do %>
            <div class="mb-3">
              <%= label_tag :child_url, "Child's URL", class: "form-label" %>
              <%= text_field_tag :child_url, nil, class: "form-control", placeholder: "https://app.kinderpedia.co/mykp/children/view-child/312368/general", required: true %>
              <div class="form-text">Enter the full URL of the child's page</div>
            </div>
<br>
            <%= submit_tag "Download Documents", class: "btn btn-primary w-100" %>
          <% end %>
          <br>
          <%= form_tag download_all_kinderpedia_path, method: :post do %>
            <%= submit_tag "Download Documents for All Children", class: "btn btn-success w-100" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
